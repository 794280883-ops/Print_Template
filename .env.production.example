# =====================================================
# 生产环境变量模板
# 部署前请执行: cp .env.production.example .env
# 然后编辑 .env，替换所有 replace_with_* 占位符为真实值
# JWT_SECRET 和 CORS_ORIGIN 为必填项，缺少会导致部署失败
# =====================================================

JWT_SECRET=replace_with_random_secret_at_least_32_chars
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password
MYSQL_DATABASE=wms_print_template
MYSQL_USER=wms_app
MYSQL_PASSWORD=replace_with_strong_mysql_app_password

HTTP_PORT=80
CORS_ORIGIN=https://customprint.icu
VITE_API_BASE_URL=/api/v1

# PDF中文字体路径（默认使用项目内打包字体，通常无需修改）
# PDF_CJK_FONT_PATH=/app/fonts/ArialUnicode.ttf
